# Backend
APP_NAME=Sistema de Facturación e Inventario con IA
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sistema_facturacion

# JWT
SECRET_KEY=change-this-to-a-strong-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# CORS
CORS_ORIGINS=["http://localhost:5173"]
