# Backend
APP_NAME=Sistema de Facturación e Inventario con IA
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sistema_facturacion

# JWT
SECRET_KEY=change-this-to-a-strong-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI (Fase 10 - análisis/tendencias)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000

# Google Gemini (Fase 12 - NEXORA AI Operativo: chat, escaneo de facturas, acciones)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=2048
GEMINI_TIMEOUT=60

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# ---------------------------------------------------------------------------
# Licenciamiento (instalación local)
# ---------------------------------------------------------------------------
# Clave pública del servicio central (PEM en línea o ruta al archivo .pem).
# NUNCA colocar aquí la clave privada.
LICENSE_PUBLIC_KEY_PATH=
LICENSE_PUBLIC_KEY_PEM=
# URL del servicio central de licencias para la activación por internet.
LICENSE_SERVER_URL=http://localhost:8100
# Activa el bloqueo por licencia. Por defecto solo se activa en producción
# (APP_ENV=production); en desarrollo queda desactivado.
LICENSE_ENFORCEMENT_ENABLED=false
LICENSE_APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Licenciamiento (servicio central - solo en el servidor del propietario)
# ---------------------------------------------------------------------------
# Base de datos propia del servicio central (separada de la del supermercado).
LICENSE_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nexora_licenses
# Clave PRIVADA de firma Ed25519. Mantener fuera del repositorio y protegida.
# La clave pública se toma de LICENSE_PUBLIC_KEY_PATH/PEM (ver sección local).
LICENSE_SIGNING_KEY_PATH=
LICENSE_JWT_SECRET=change-this-license-jwt-secret
LICENSE_ACCESS_TOKEN_EXPIRE_MINUTES=720
LICENSE_CORS_ORIGINS=["http://localhost:5174"]
